# Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# EmailJS Configuration
# Get your keys from: https://www.emailjs.com/
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here
VITE_EMAILJS_SERVICE_ID=your_service_id_here
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here

# Cloudflare Turnstile (CAPTCHA)
# Get your site key from: https://dash.cloudflare.com/
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key_here

# Recipient Email
VITE_RECIPIENT_EMAIL=your_email@example.com

# Contact auto-reply endpoint (Cloudflare Worker)
# Production example:
# VITE_CONTACT_ACK_URL=https://portfolio-contact-ack.braulioecheverria.workers.dev
VITE_CONTACT_ACK_URL=

# Analytics (Optional)
VITE_ANALYTICS_ENABLED=false
VITE_ANALYTICS_ID=your_analytics_id_here
