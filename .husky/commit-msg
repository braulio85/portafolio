#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# Get the commit message
commit_msg=$(cat "$1")

# Regex for conventional commits
# Format: type(scope): subject
# Example: feat(skills): add new programming languages
regex='^(feat|fix|docs|style|refactor|perf|test|chore|ci|build|revert)(\([a-z0-9\-]*\))?: .{1,}$'

if ! echo "$commit_msg" | grep -qE "$regex"; then
  echo "Commit message format is invalid!"
  echo ""
  echo "Required format: type(scope): subject"
  echo ""
  echo "Valid types: feat, fix, docs, style, refactor, perf, test, chore, ci, build, revert"
  echo ""
  echo "Examples:"
  echo "  feat(skills): add new programming languages"
  echo "  fix(loader): update color scheme"
  echo "  docs: update README"
  echo "  style(css): format stylesheet"
  echo ""
  exit 1
fi

echo "Commit message format is valid!"
