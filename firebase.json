{
    "hosting": {
        "public": "dist",
        "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
        "headers": [
            {
                "source": "/assets/**",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "public,max-age=31536000,immutable"
                    }
                ]
            },
            {
                "source": "/images/**",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "public,max-age=604800"
                    }
                ]
            },
            {
                "source": "/data/**",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "public,max-age=3600"
                    }
                ]
            },
            {
                "source": "/index.html",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "public,max-age=0,must-revalidate"
                    }
                ]
            },
            {
                "source": "**/*.@(js|css|woff2|woff|ttf|svg|webp|png|jpg|jpeg|ico)",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "public,max-age=604800"
                    }
                ]
            }
        ]
    }
}
